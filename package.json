{
  "name": "wassail",
  "version": "1.2.0",
  "description": "Advent of Code helper for Node.js: fetch and cache inputs, submit answers, and pull private leaderboards.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "wassail": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "npm@11.20.0",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "globals": "^17.14.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.6.0"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "prepack": "vp pack",
    "prepublishOnly": "vp check && vp test",
    "prepare": "vp config"
  },
  "keywords": [
    "advent-of-code",
    "aoc",
    "cli",
    "typescript",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snally-dev/wassail.git"
  },
  "author": "Caleb Kinney",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/snally-dev/wassail/issues"
  },
  "homepage": "https://github.com/snally-dev/wassail#readme",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  }
}
